{
  "name": "@mcp-workspace/shared",
  "version": "1.0.0",
  "description": "Shared contracts and interfaces for MCP Workspace Aggregation",
  "main": "error-codes.js",
  "types": "types.d.ts",
  "scripts": {
    "test": "jest workspace-config.schema.test.js",
    "test:watch": "jest --watch workspace-config.schema.test.js",
    "validate:schema": "ajv validate -s workspace-config.schema.json -d ../../../test-config.json"
  },
  "files": [
    "workspace-config.schema.json",
    "error-codes.js",
    "types.d.ts",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "workspace",
    "aggregation",
    "contracts"
  ],
  "author": "MCP Workspace Team",
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.12.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "!*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}